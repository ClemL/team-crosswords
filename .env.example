# Upstash Redis (server-side only; never exposed to the browser)
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>
# Protects POST /api/admin/seed
ADMIN_SEED_SECRET=change-me

# Optional, local development / tests only:
# XW_STORE=memory                 # in-process store instead of Upstash (single process only)
# XW_CONFIG_OVERRIDES={"cooldownMs":1000,"rotationWarningMs":500}
